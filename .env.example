# Copia este archivo a .env y ajusta los valores para tu entorno.
# .env NO se versiona (ver .gitignore). Solo .env.example va al repo.
#
# IMPORTANTE: las variables VITE_* son PÚBLICAS (Vite las incrusta en el bundle).
# No pongas aquí secretos, tokens ni credenciales: solo configuración.

# URL base de la API, incluyendo /api y sin barra final.
# Local (API_PPOO, perfil http): http://localhost:5114/api
VITE_API_URL=http://localhost:5114/api

# Drawer de trazas HTTP. Usa 'false' en producción.
VITE_HTTP_TRACE=true
